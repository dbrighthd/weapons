{
    "model": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_name",
      "cases": [
        {
          "when":["Stone Comically Large Spoon", "Comically Large Spoon", "iregex:.*Large.*Spoon.*"],
          "model": {
            "type":"minecraft:model",
            "model":"minecraft:item/.weapons/comically_large_utensils/stone_comically_large_spoon"
          }
        }
      ],
      "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:component",
      "predicate": "minecraft:enchantments",
      "value": [
        {
          "enchantments": "minecraft:fortune"
        }
      ],
      "on_true": {
        "type": "minecraft:model",
        "model": "minecraft:item/.weapons/flaming_swords/defaults/lucky_stone_shovel"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "minecraft:item/stone_shovel"
      }
      }
    }
  }